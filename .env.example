# Copy to .env (git-ignored) and fill in. Used by:
#   docker run --rm --env-file .env -p 8080:8080 <registry>/gestor-salon-eventos:<tag>
# Every variable must exist, even if empty: application-prod.yml has no defaults.
SPRING_PROFILES_ACTIVE=prod
DATABASE_URL=jdbc:mysql://HOST:PORT/defaultdb?sslMode=REQUIRED
DB_USERNAME=
DB_PASSWORD=
JWT_SECRET=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=