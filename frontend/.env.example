# Copy to .env (git-ignored) and adjust. Everything that starts with VITE_ ends up in the
# JavaScript the browser downloads: never put a secret here.
VITE_API_URL=http://localhost:8080/api/v1

# Empty: images are uploaded to the backend (/images/upload). With the Function URL of the
# image Lambda: they are uploaded there. See docs/lambdas-plan.md.
VITE_UPLOAD_URL=